# =============================================================
# Sabor de Botequim — Variáveis de ambiente
# Copie para .env.local (dev) ou .env (produção VPS) e preencha.
# NUNCA versione o arquivo preenchido com valores reais.
# =============================================================

# --- Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave com acesso total — usada SOMENTE no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança (CPF — fluxo legado do seed) -------------------
CPF_HASH_SALT=
CPF_ENCRYPTION_KEY=
IP_HASH_SALT=
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=10

# --- CAPTCHA (Cloudflare Turnstile) ---------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Votação por WhatsApp -------------------------------------
# Salt do hash de duplicidade por número (32+ chars aleatórios).
WHATSAPP_HASH_SALT=
# Chave de criptografia do número (pgcrypto). Guardar backup seguro.
WHATSAPP_ENCRYPTION_KEY=
# Pepper do código OTP (o código em texto puro nunca vai ao banco).
OTP_PEPPER=

# Provedor: dev | meta | evolution | n8n. "dev" não envia de verdade e é
# bloqueado automaticamente em produção (NODE_ENV=production).
WHATSAPP_PROVIDER=dev
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Webhook do n8n (usado quando WHATSAPP_PROVIDER=n8n). O workflow recebe
# { phone, code, message } via POST e é responsável por enviar de fato
# o WhatsApp (Evolution API, Meta, Z-API etc. do lado do n8n).
N8N_WEBHOOK_URL=

# Configuração do OTP
OTP_TTL_SECONDS=300
OTP_RESEND_MIN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3

# --- Aplicação ------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Senha das contas de demonstração (usada apenas pelos scripts de teste).
# Use aspas se a senha tiver "#", senão o valor é truncado no parser do .env.
DEMO_PASSWORD=""
